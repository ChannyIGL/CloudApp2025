generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EscapeResult {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  timeRemaining  Int
  itemsCollected String[]
  notes          String?
}
